+//! Research overlays preserve the adopted v2.2 policy and its route memory.
+use super::*;
+
+pub(super) fn recommend(
+    version: GenericSolverVersion,
+    recipe: &RecipeProfile,
+    crafter: &CrafterProfile,
+    state: &CraftState,
+    objective: GenericObjective,
+    risk: RiskPreference,
+    context: &PlannerContext,
+    mask: Option<u16>,
+) -> Option<GenericDecision> {
+    let base = recommend_generic_action_with_model(
+        GenericSolverVersion::ExternalReferenceV22,
+        recipe,
+        crafter,
+        state,
+        objective,
+        risk,
+        context,
+        mask,
+    )?;
+    if context.last_action == Some(CraftActionId::Reflect) && state.buffs.manipulation == 0 {
+        let proposal = artisan_continuation::improve_research(
+            recipe, crafter, state, objective, context, mask, base, 1, false, false, false,
+        );
+        if proposal.action == CraftActionId::Manipulation {
+            return Some(proposal);
+        }
+    }
+    if version == GenericSolverVersion::OpeningRiskContinuation {
+        return Some(artisan_continuation::improve_research(
+            recipe, crafter, state, objective, context, mask, base, 6, true, false, false,
+        ));
+    }
+    if version == GenericSolverVersion::OpeningPairContinuation {
+        if base.route.is_some_and(|r| r.certified_actions.is_some()) {
+            return Some(base);
+        }
+        if context.route_memory.matches(state) {
+            if let Some(plan) = context
+                .route_memory
+                .active
+                .filter(|r| r.certified_actions.is_none() && r.setup == context.last_action)
+            {
+                if let Some(consumer) = plan
+                    .consumer
+                    .and_then(|a| artisan_continuation::safe_consumer(recipe, crafter, state, a))
+                {
+                    return Some(consumer);
+                }
+            }
+        }
+        return Some(artisan_continuation::improve_research(
+            recipe, crafter, state, objective, context, mask, base, 1, false, true, false,
+        ));
+    }
+    if version == GenericSolverVersion::OpeningForecastRescue {
+        return Some(artisan_continuation::improve_research(
+            recipe, crafter, state, objective, context, mask, base, 6, false, false, true,
+        ));
+    }
+    Some(base)
+}
+
