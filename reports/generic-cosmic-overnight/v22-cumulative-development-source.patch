+                &crafter,
+                &resynced,
+                CraftActionId::RefinedTouch
+            )
+            .is_none()
+        );
+        let mut deviated = root;
+        deviated.action = CraftActionId::HastyTouch;
+        let after_deviation =
+            branch_state(&recipe, &crafter, &state, deviated.action, true).unwrap();
+        advance_planner_context(
+            &mut context,
+            GenericSolverVersion::OpeningPairContinuation,
+            deviated,
+            &state,
+            &after_deviation,
+        );
+        assert!(context.route_memory.active.is_none());
+    }
+}
