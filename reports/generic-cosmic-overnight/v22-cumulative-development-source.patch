+pub(super) fn safe_consumer(
+    recipe: &RecipeProfile,
+    crafter: &CrafterProfile,
+    state: &CraftState,
+    action: CraftActionId,
+) -> Option<GenericDecision> {
+    let p = preview_action(recipe, crafter, state, action);
+    if !p.legal || p.success_rate != 1.0 {
+        return None;
+    }
+    let after = branch_state(recipe, crafter, state, action, true)?;
+    (after.terminal != CraftTerminal::Failed).then(|| action_decision(action))
+}
+
+fn threatens_failure(
+    recipe: &RecipeProfile,
+    crafter: &CrafterProfile,
+    state: &CraftState,
+    decision: Option<GenericDecision>,
+) -> bool {
+    let Some(decision) = decision else {
+        return true;
+    };
+    let p = preview_action(recipe, crafter, state, decision.action);
+    !p.legal
+        || [true, false].into_iter().any(|success| {
+            (success || p.success_rate < 1.0)
+                && branch_state(recipe, crafter, state, decision.action, success)
+                    .is_none_or(|after| after.terminal == CraftTerminal::Failed)
+        })
+}
