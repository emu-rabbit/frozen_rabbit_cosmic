+++ b/native/craft-kernel/src/generic_solver/opening_recovery.rs
@@ -0,0 +1,137 @@
+//! Retained positive research component. The adopted v2.2 policy is unchanged.
+use super::*;
+
+pub(super) fn recommend_repair(
+    version: GenericSolverVersion,
+    recipe: &RecipeProfile,
+    crafter: &CrafterProfile,
+    state: &CraftState,
+    objective: GenericObjective,
+    risk: RiskPreference,
+    context: &PlannerContext,
+    mask: Option<u16>,
+) -> Option<GenericDecision> {
+    let base = recommend_generic_action_with_model(
+        GenericSolverVersion::ExternalReferenceV22,
+        recipe,
+        crafter,
+        state,
+        objective,
+        risk,
+        context,
+        mask,
+    )?;
+    let mut opening = base;
+    if context.last_action == Some(CraftActionId::Reflect) && state.buffs.manipulation == 0 {
+        let proposal = artisan_continuation::improve_opening(
+            recipe, crafter, state, objective, context, mask, base,
+        );
+        if proposal.action == CraftActionId::Manipulation {
+            opening = proposal;
+        }
+    }
+    Some(artisan_continuation::repair_opening(
+        version, recipe, crafter, state, objective, context, mask, base, opening,
+    ))
+}
+
+pub(super) fn recommend(
+    recipe: &RecipeProfile,
+    crafter: &CrafterProfile,
+    state: &CraftState,
+    objective: GenericObjective,
+    risk: RiskPreference,
+    context: &PlannerContext,
+    mask: Option<u16>,
+) -> Option<GenericDecision> {
+    let base = recommend_generic_action_with_model(
+        GenericSolverVersion::ExternalReferenceV22,
+        recipe,
+        crafter,
+        state,
+        objective,
+        risk,
+        context,
+        mask,
+    )?;
+    if context.last_action == Some(CraftActionId::Reflect) && state.buffs.manipulation == 0 {
+        let proposal = artisan_continuation::improve_opening(
+            recipe, crafter, state, objective, context, mask, base,
+        );
+        if proposal.action == CraftActionId::Manipulation {
+            return Some(proposal);
+        }
+    }
+    Some(base)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn decision(action: CraftActionId) -> GenericDecision {
+        GenericDecision {
+            action,
+            route: None,
+            persona: PlannerPersona::LegacyContinuation,
+            option: PlannerOption::ProgressWindow,
+        }
+    }
+
+    #[test]
+    fn deferred_window_tracks_actual_success_failure_and_manual_deviation() {
+        let recipe = super::super::tests::hard_quality_recipe();
+        let crafter = super::super::tests::five_meld_buffed_crafter();
+        let initial = CraftState::initial(&recipe, &crafter);
+        let reflected =
+            branch_state(&recipe, &crafter, &initial, CraftActionId::Reflect, true).unwrap();
+        let mut context = PlannerContext::default();
+        advance_planner_context(
+            &mut context,
+            GenericSolverVersion::OpeningDeferred,
+            decision(CraftActionId::Reflect),
+            &initial,
+            &reflected,
+        );
+        assert!(!context.opening_recovery_pending);
+        for success in [false, true] {
+            let after = branch_state(
+                &recipe,
+                &crafter,
+                &reflected,
+                CraftActionId::RapidSynthesis,
+                success,
+            )
+            .unwrap();
+            let mut observed = context.clone();
+            advance_planner_context(
+                &mut observed,
+                GenericSolverVersion::OpeningDeferred,
+                decision(CraftActionId::RapidSynthesis),
+                &reflected,
+                &after,
+            );
+            assert!(observed.opening_recovery_pending);
+            assert_eq!(after.progress > reflected.progress, success);
+            let next =
+                branch_state(&recipe, &crafter, &after, CraftActionId::Observe, true).unwrap();
+            advance_planner_context(
+                &mut observed,
+                GenericSolverVersion::OpeningDeferred,
+                decision(CraftActionId::Observe),
+                &after,
+                &next,
+            );
+            assert!(!observed.opening_recovery_pending);
+        }
+        let after_manual =
+            branch_state(&recipe, &crafter, &reflected, CraftActionId::Observe, true).unwrap();
+        advance_planner_context(
+            &mut context,
+            GenericSolverVersion::OpeningDeferred,
+            decision(CraftActionId::Observe),
+            &reflected,
+            &after_manual,
+        );
+        assert!(!context.opening_recovery_pending);
+    }
+}
