+fn confirm_manipulation(
+    input: Input<'_>,
+    base: GenericDecision,
+    offset: u32,
+    samples: u32,
+    margin: u32,
+) -> GenericDecision {
+    if input.recipe.required_quality <= 0
+        || input.state.quality >= input.recipe.quality_max
+        || input.state.buffs.manipulation != 0
+        || declared_next_conditions(input.mask).next().is_none()
+    {
+        return base;
+    }
+    let p = preview_action(
+        input.recipe,
+        input.crafter,
+        input.state,
+        CraftActionId::Manipulation,
+    );
+    if !p.legal
+        || branch_state(
+            input.recipe,
+            input.crafter,
+            input.state,
+            CraftActionId::Manipulation,
+            true,
+        )
+        .is_none_or(|s| s.terminal == CraftTerminal::Failed)
+    {
+        return base;
+    }
+    let proposal = action_decision(CraftActionId::Manipulation);
+    let mut gain = 0;
+    for scarce in [false, true] {
+        let b = evaluate(input, base, offset, samples, scarce);
+        let c = evaluate(input, proposal, offset, samples, scarce);
+        if c.completed < b.completed || c.full < b.full {
+            return base;
+        }
+        gain += c.full - b.full;
+    }
+    if gain >= margin { proposal } else { base }
+}
