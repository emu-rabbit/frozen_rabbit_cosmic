--- /dev/null
+++ b/native/craft-kernel/src/generic_solver/quality_construction.rs
@@ -0,0 +1,243 @@
+//! Bounded research overlays on v2.2. Existing policy identities stay unchanged.
+use super::*;
+
+fn decision(action: CraftActionId) -> GenericDecision {
+    GenericDecision {
+        action,
+        route: None,
+        persona: PlannerPersona::LegacyContinuation,
+        option: if action_definition(action).category == ActionCategory::Progress {
+            PlannerOption::ProgressWindow
+        } else {
+            PlannerOption::QualityCycle
+        },
+    }
+}
+
+pub(super) fn recommend(
+    version: GenericSolverVersion,
+    recipe: &RecipeProfile,
+    crafter: &CrafterProfile,
+    state: &CraftState,
+    objective: GenericObjective,
+    risk: RiskPreference,
+    context: &PlannerContext,
+    mask: Option<u16>,
+) -> Option<GenericDecision> {
+    if recipe.required_quality > 0 && context.action_uses < context.action_limit {
+        if version == GenericSolverVersion::MuscleOpening && state.step == 1 {
+            let p = preview_action(recipe, crafter, state, CraftActionId::MuscleMemory);
+            if p.legal && state.progress + p.progress_gain < recipe.progress_required {
+                return Some(decision(CraftActionId::MuscleMemory));
+            }
+        }
+        if version == GenericSolverVersion::EarlyRefinement
+            && state.inner_quiet < 10
+            && state.inner_quiet > 0
+            && state.quality < recipe.quality_max
+        {
+            let next = if context.last_action == Some(CraftActionId::BasicTouch)
+                && state.inner_quiet <= 8
+            {
+                Some(CraftActionId::RefinedTouch)
+            } else {
+                None
+            };
+            if let Some(a) = next {
+                let p = preview_action(recipe, crafter, state, a);
+                if p.legal && state.durability > p.durability_cost {
+                    return Some(decision(a));
+                }
+            }
+        }
+    }
+    let base = recommend_generic_action_with_model(
+        GenericSolverVersion::ExternalReferenceV22,
+        recipe,
+        crafter,
+        state,
+        objective,
+        risk,
+        context,
+        mask,
+    )?;
+    if version == GenericSolverVersion::EarlyRefinement
+        && recipe.required_quality > 0
+        && state.inner_quiet > 0
+        && state.inner_quiet <= 6
+        && state.quality < recipe.quality_max
+        && context.action_limit.saturating_sub(context.action_uses) >= 3
+        && matches!(
+            state.condition,
+            MaterialCondition::Normal | MaterialCondition::Primed
+        )
+        && matches!(
+            base.action,
+            CraftActionId::Observe | CraftActionId::HastyTouch | CraftActionId::DaringTouch
+        )
+        && state.cp >= 42 + 74
+        && state.durability > 20
+    {
+        let p = preview_action(recipe, crafter, state, CraftActionId::BasicTouch);
+        if p.legal {
+            return Some(decision(CraftActionId::BasicTouch));
+        }
+    }
+    if version == GenericSolverVersion::ConditionAllocation
+        && recipe.required_quality > 0
+        && state.quality < recipe.quality_max
+        && state.inner_quiet > 0
+        && state.inner_quiet <= 8
+        && matches!(
+            state.condition,
+            MaterialCondition::Sturdy | MaterialCondition::Robust
+        )
+        && mask.is_some_and(|m| m & ((1 << 2) | (1 << 5)) != 0)
+        && base.action == CraftActionId::RapidSynthesis
+        && state.cp >= 40 + 74
+        && context.action_limit.saturating_sub(context.action_uses) >= 6
+    {
+        let p = preview_action(recipe, crafter, state, CraftActionId::PreparatoryTouch);
+        if p.legal && state.durability > p.durability_cost {
+            return Some(decision(CraftActionId::PreparatoryTouch));
+        }
+    }
+    if version == GenericSolverVersion::OpeningRecovery
+        && context.last_action == Some(CraftActionId::Reflect)
+        && state.buffs.manipulation == 0
+    {
+        let proposal = artisan_continuation::improve_early(
+            recipe, crafter, state, objective, context, mask, base,
+        );
+        if proposal.action == CraftActionId::Manipulation {
+            return Some(proposal);
+        }
+    }
+    if version == GenericSolverVersion::EarlyContinuation && state.inner_quiet < 6 {
+        return Some(artisan_continuation::improve_early(
+            recipe, crafter, state, objective, context, mask, base,
+        ));
+    }
+    Some(base)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn allocation_spends_only_an_existing_durability_discount() {
+        let recipe = super::super::tests::hard_quality_recipe();
+        let crafter = super::super::tests::five_meld_buffed_crafter();
+        let mut state = CraftState::initial(&recipe, &crafter);
+        state.step = 10;
+        state.inner_quiet = 2;
+        state.condition = MaterialCondition::Sturdy;
+        state.cp = 500;
+        state.durability = 40;
+        state.quick_innovation_available = false;
+        let objective = GenericObjective {
+            quality_maximum: recipe.quality_max,
+            protected_quality_floor: recipe.quality_max,
+            adaptive_completion: false,
+            quality_utility_kind: QualityUtilityKind::HardQualityMaximum,
+            quality_milestone_count: 1,
+            quality_milestones: [recipe.quality_max, 0, 0, 0],
+        };
+        let context = PlannerContext::default();
+        let choose = |s: &CraftState, mask| {
+            recommend(
+                GenericSolverVersion::ConditionAllocation,
+                &recipe,
+                &crafter,
+                s,
+                objective,
+                RiskPreference::Balanced,
+                &context,
+                Some(mask),
+            )
+            .unwrap()
+            .action
+        };
+        assert_eq!(choose(&state, 255), CraftActionId::PreparatoryTouch);
+        assert_eq!(
+            choose(&state, (1 << 0) | (1 << 3)),
+            CraftActionId::RapidSynthesis
+        );
+        state.cp = 100;
+        assert_eq!(choose(&state, 255), CraftActionId::RapidSynthesis);
+    }
+    #[test]
+    fn research_openings_preserve_non_hard_quality_and_recipe_aliases() {
+        let mut recipe = super::super::tests::hard_quality_recipe();
+        let crafter = super::super::tests::five_meld_buffed_crafter();
+        let state = CraftState::initial(&recipe, &crafter);
+        let context = PlannerContext::default();
+        let objective = GenericObjective {
+            quality_maximum: recipe.quality_max,
+            protected_quality_floor: recipe.quality_max,
+            adaptive_completion: false,
+            quality_utility_kind: QualityUtilityKind::HardQualityMaximum,
+            quality_milestone_count: 1,
+            quality_milestones: [recipe.quality_max, 0, 0, 0],
+        };
+        for version in [
+            GenericSolverVersion::MuscleOpening,
+            GenericSolverVersion::EarlyRefinement,
+            GenericSolverVersion::ConditionAllocation,
+            GenericSolverVersion::EarlyContinuation,
+            GenericSolverVersion::OpeningRecovery,
+        ] {
+            let a = recommend(
+                version,
+                &recipe,
+                &crafter,
+                &state,
+                objective,
+                RiskPreference::Balanced,
+                &context,
+                Some(255),
+            )
+            .unwrap();
+            assert!(preview_action(&recipe, &crafter, &state, a.action).legal);
+            recipe.canonical_recipe_id += 1;
+            assert_eq!(
+                a,
+                recommend(
+                    version,
+                    &recipe,
+                    &crafter,
+                    &state,
+                    objective,
+                    RiskPreference::Balanced,
+                    &context,
+                    Some(255)
+                )
+                .unwrap()
+            );
+            let mut optional = recipe.clone();
+            optional.required_quality = 0;
+            assert_eq!(
+                recommend(
+                    version,
+                    &optional,
+                    &crafter,
+                    &state,
+                    objective,
+                    RiskPreference::Balanced,
+                    &context,
+                    Some(255)
+                ),
+                recommend_generic_action_with_model(
+                    GenericSolverVersion::ExternalReferenceV22,
+                    &optional,
+                    &crafter,
+                    &state,
+                    objective,
+                    RiskPreference::Balanced,
+                    &context,
+                    Some(255)
+                )
+            );
+        }
+    }
+}
