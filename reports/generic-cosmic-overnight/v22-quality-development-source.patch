+use frozen_rabbit_craft_kernel::research::*;
+fn main() {
+    let path = std::env::args().nth(1).expect("input TSV");
+    let input = std::fs::read_to_string(path).unwrap();
+    for line in input.lines() {
+        let case = parse_generic_episode_case(line).unwrap();
+        execute_generic_episode_with_observer(&case, |state, _, decision, _, _| {
+            if let Some(d) = decision {
+                let p =
+                    preview_action(&case.rollout.recipe, &case.rollout.crafter, state, d.action);
+                if !p.legal {
+                    println!("{}\n{:?}\n{:?}\n{:?}", case.rollout.case_id, state, d, p);
+                }
+            }
+        })
+        .unwrap();
+    }
+}
